generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           Int     @id @default(autoincrement())
  name         String  @db.VarChar(100)
  email        String  @unique @db.VarChar(50)
  password     String  @db.VarChar(255)
  verified     Boolean @default(false)
  refreshToken String? @map("refresh_token")

  clientApps ClientApp[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("users")
}

model ClientApp {
  id     Int  @id @default(autoincrement())
  userId Int  @map("user_id")
  user   User @relation(fields: [userId], references: [id], onUpdate: Cascade, onDelete: Cascade)

  name     String
  key      String  @unique
  secret   String
  isActive Boolean @default(true)

  channels Channel[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([userId])
  @@map("client_apps")
}

model Channel {
  id          Int       @id @default(autoincrement())
  clientAppId Int       @map("client_app_id")
  clientApp   ClientApp @relation(fields: [clientAppId], references: [id], onDelete: Cascade)

  name String
  type ChannelType

  members  Presence[]
  webhooks WebhookDelivery[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([clientAppId, name])
  @@index([clientAppId])
  @@map("channels")
}

model Presence {
  id        Int     @id @default(autoincrement())
  channelId Int     @map("channel_id")
  channel   Channel @relation(fields: [channelId], references: [id], onDelete: Cascade)

  userId   String @map("user_id")
  socketId String @map("socket_id")

  joinedAt DateTime  @default(now()) @map("joined_at")
  leftAt   DateTime? @map("left_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([channelId, socketId])
  @@index([userId])
  @@index([socketId])
  @@map("presences")
}

model WebhookDelivery {
  id        String   @id @default(uuid())
  channelId Int?     @map("channel_id")
  channel   Channel? @relation(fields: [channelId], references: [id], onDelete: Cascade)

  event   String
  payload Json
  url     String?     @db.Text
  type    WebhookType @default(HTTP)

  status    WebhookStatus @default(PENDING)
  attempts  Int           @default(0)
  lastError String?       @map("last_error") @db.Text

  nextRetry   DateTime? @map("next_retry")
  deliveredAt DateTime? @map("delivered_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([status])
  @@index([nextRetry])
  @@index([channelId])
  @@map("webhook_deliveries")
}

enum ChannelType {
  PUBLIC
  PRIVATE
  PRESENCE
}

enum WebhookStatus {
  PENDING
  SUCCESS
  FAILED
  DEAD
}

enum WebhookType {
  HTTP
  WEBSOCKET
}
